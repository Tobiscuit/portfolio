{
  // Copied from payloadcms/payload templates/with-cloudflare-d1/wrangler.jsonc (main, 2026-10-20),
  // renamed for the spike. Differences from the template are marked "spike:".
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "portfolio-spike",
  // spike: template says 2025-08-15; wrangler 4.151.3 bundles workerd 1.20261019.1, and spec 003 §5
  // wants >= 2026-04-21 for the real site, so the spike runs on a current date.
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    // Enable Node.js API
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
    "nodejs_compat",
    // Allow to fetch URLs in your app
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "D1",
      // spike: paste the id printed by `wrangler d1 create portfolio-spike-d1` (README, remote steps).
      // Any string works for the local simulation.
      "database_id": "DATABASE_ID",
      "database_name": "portfolio-spike-d1"
      // spike: the template sets "remote": true, which makes `wrangler dev` use the real D1 through
      // the account. This run has no account token (Vault sealed), so the binding stays local.
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "portfolio-spike-media"
    }
    // Create a R2 binding with the binding name "NEXT_INC_CACHE_R2_BUCKET"
    // {
    //   "binding": "NEXT_INC_CACHE_R2_BUCKET",
    //   "bucket_name": "<BUCKET_NAME>",
    // },
  ],
  "services": [
    // The service should match the "name" of your worker
    // {
    //   "binding": "WORKER_SELF_REFERENCE",
    //   "service": "portfolio-spike"
    // },
  ]
}
