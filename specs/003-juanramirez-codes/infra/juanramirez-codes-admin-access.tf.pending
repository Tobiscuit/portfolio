# PARKED 2026-10-20 - Access in front of the Payload admin on juanramirez.codes
# (portfolio spec 003, D9: the second lock). Not approved yet. Copy of
# ~/portfolio/specs/003-juanramirez-codes/infra/juanramirez-codes-admin-access.tf.pending.
#
# Depends on: juanramirez-codes-zone.tf applied and the zone Active, and the
# Worker deployed on the custom domain. Apply before the first /admin visit
# from anywhere but the preview URL.
#
# WHAT IS COVERED. Payload has its own authentication (cookie JWT with a
# sessions table), so this is defence in depth, not the only lock: the admin
# UI and the three endpoints that take credentials.
#
#   /admin*                       the admin pages (and their .rsc payloads -
#                                 the wildcard matters, as montanobtm-admin-
#                                 access.tf explains)
#   /api/users/login*             the login POST the admin UI makes; it
#                                 carries the Access cookie, so the UI keeps
#                                 working behind this
#   /api/users/first-register*    open only until the first user exists; gated
#                                 anyway so nobody races the owner to it
#   /api/users/forgot-password*   sends nothing on Workers (no email adapter,
#                                 D9) but should not be a public endpoint
#
# Deliberately NOT covered: /api/media/file/* (the site's own images), the
# REST reads of /api/projects etc. (public content, `access.read: () => true`),
# /api/contact (the inquiry POST behind Turnstile), /media/* (engine media).
# Writes through the REST API outside /admin need a Payload session, which
# only the gated login can mint.
#
# Approve with:
#   cd /home/link/cloudflare-infra && mv juanramirez-codes-admin-access.tf.pending juanramirez-codes-admin-access.tf && ./tf plan
#   expect: 2 to add (policy, application), 0 to change, 0 to destroy.

variable "juanramirez_admin_emails" {
  description = "Addresses allowed into the portfolio's Payload admin: the owner only."
  type        = list(string)
  default     = ["tobiasramzy@gmail.com"]

  validation {
    condition     = length(var.juanramirez_admin_emails) > 0
    error_message = "Set juanramirez_admin_emails to at least one address - an empty include allows nobody and Cloudflare rejects it."
  }
}

resource "cloudflare_zero_trust_access_policy" "juanramirez_admin_allow" {
  account_id = var.cloudflare_account_id
  name       = "juanramirez.codes admin - the owner"
  decision   = "allow"

  include = [
    for email in var.juanramirez_admin_emails : {
      email = {
        email = email
      }
    }
  ]
}

resource "cloudflare_zero_trust_access_application" "juanramirez_admin" {
  account_id = var.cloudflare_account_id
  type       = "self_hosted"
  name       = "juanramirez.codes admin"

  destinations = [
    { type = "public", uri = "juanramirez.codes/admin*" },
    { type = "public", uri = "juanramirez.codes/api/users/login*" },
    { type = "public", uri = "juanramirez.codes/api/users/first-register*" },
    { type = "public", uri = "juanramirez.codes/api/users/forgot-password*" },
  ]

  # One person editing his own site from a phone now and then; the same
  # month-long session the montanobtm admin uses, for the same reason.
  session_duration = "730h"

  http_only_cookie_attribute = true

  policies = [
    {
      id         = cloudflare_zero_trust_access_policy.juanramirez_admin_allow.id
      precedence = 1
    }
  ]
}
