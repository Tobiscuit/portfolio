# PARKED 2026-10-20 - jrcodex.dev and www.jrcodex.dev 301 to juanramirez.codes,
# path and query preserved (portfolio spec 003, D2). Not approved yet. Copy of
# ~/portfolio/specs/003-juanramirez-codes/infra/jrcodex-dev-redirect.tf.pending.
#
# Depends on, in order:
#   1. juanramirez.codes live on the Worker (zone Active, custom domain attached),
#      so the redirect lands somewhere.
#   2. The Vercel project retired. Today dns.tf has the apex as A 76.76.21.21
#      and www as CNAME cname.vercel-dns.com, both `proxied = false`. A
#      redirect rule only runs on PROXIED traffic, so both records must become
#      proxied placeholders - the edit to dns.tf, NOT made here:
#
#        resource "cloudflare_dns_record" "jrcodex_dev"  { ... type = "A"  content = "192.0.2.1" proxied = true  comment = "placeholder: redirect rule answers" }
#        resource "cloudflare_dns_record" "www"          { ... type = "A"  content = "192.0.2.1" proxied = true  comment = "placeholder: redirect rule answers" }
#
#      192.0.2.1 is TEST-NET-1 (RFC 5737): it never routes, so if the rule is
#      ever removed the hostnames fail closed instead of pointing at a stranger.
#      Flipping the records before the Vercel site is retired would break the
#      live site; flipping them after the rule exists is harmless (the rule
#      answers first).
#
# The rule uses the same shape as proprietorsystems-com.tf.pending. It covers
# every path: the old /projects, /about and /contact URLs on LinkedIn and the
# CV keep resolving, to the new site's matching paths (spec 003 keeps /about
# and /contact; /projects becomes /work and the app serves a 301 for that one
# path itself, so this rule stays path-agnostic).
#
# What else jrcodex.dev keeps: every other record in dns.tf (ssh, the SES
# sending identity, the engine's review/dashboard hosts) is untouched; the
# rule matches only the apex and www.
#
# Approve with:
#   cd /home/link/cloudflare-infra && mv jrcodex-dev-redirect.tf.pending jrcodex-dev-redirect.tf && ./tf plan
#   expect: 1 to add (the ruleset), plus the 2 dns.tf changes if made in the same sitting.

locals {
  # dns.tf's literal for the jrcodex.dev zone.
  jrcodex_dev_zone_id = "eb3ea45d1bed705d658924bae5b259bc"
}

# 301 at the edge, before any Worker runs, preserving path and query.
resource "cloudflare_ruleset" "jrcodex_dev_redirect" {
  zone_id = local.jrcodex_dev_zone_id
  name    = "jrcodex.dev to juanramirez.codes"
  kind    = "zone"
  phase   = "http_request_dynamic_redirect"

  rules = [
    {
      description = "301 jrcodex.dev (and www) -> juanramirez.codes, preserving path and query"
      expression  = "http.host in {\"jrcodex.dev\" \"www.jrcodex.dev\"}"
      action      = "redirect"
      enabled     = true
      action_parameters = {
        from_value = {
          status_code           = 301
          preserve_query_string = true
          target_url = {
            expression = "concat(\"https://juanramirez.codes\", http.request.uri.path)"
          }
        }
      }
    }
  ]
}
