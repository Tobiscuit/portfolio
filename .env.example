# Database Connection
# MongoDB Atlas Bundle URI or standard connection string
DATABASE_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/payload-portfolio?retryWrites=true&w=majority

# Payload Secret
# Generate a random string (e.g., `openssl rand -hex 32`)
PAYLOAD_SECRET=your-secret-here

# AWS S3 Storage (You likely already have these, just add S3_BUCKET)
S3_BUCKET=your-bucket-name
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1

# ── Contact form (app/api/contact/route.ts) ─────────────────────────────────
# The route picks its path on every request (specs/001-platform-intake):
#   SEO_ENGINE_URL set -> the platform: the SEO engine's Inquiries
#   otherwise          -> the legacy SES path further down, unchanged
# Rollback is removing SEO_ENGINE_URL. Set the platform variables in Vercel's
# Production environment only. (On Cloudflare Workers, a SEO service binding
# takes the place of SEO_ENGINE_URL; a binding is not an environment variable.)

# The engine's HTTPS base URL. Its presence is the switch.
SEO_ENGINE_URL=
# The site key for tenant "jrcodex": sk_..., a secret (Vault: secret/seo-engine/sites/jrcodex, field key).
# Missing or refused while SEO_ENGINE_URL is set: every message answers 503.
SEO_SITE_KEY=
# The only host whose requests may create inquiries. Any other host (a Vercel
# preview) answers 503 "this is a preview"; unset, every message answers 503.
ENGINE_WRITE_HOST=www.jrcodex.dev
# Where "Please email ... directly" points when a message cannot be sent
# (spec B-D4: hello@jrcodex.dev once the jrcodex mailbox is active).
CONTACT_FALLBACK_EMAIL=jramirez203@outlook.com

# Turnstile: both or neither. Both set -> checked on every message; neither ->
# skipped; only one -> every message answers 503. The site key is inlined into
# the page at build time, so changing it needs a redeploy.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# The legacy SES path, used while SEO_ENGINE_URL is unset.
SES_SENDER_EMAIL=
SES_RECIPIENT_EMAIL=
SES_AWS_ACCESS_KEY_ID=
SES_AWS_SECRET_ACCESS_KEY=
# Optional; defaults to send-jrcodex.
# SES_CONFIGURATION_SET=send-jrcodex
# The SES region is AWS_REGION (above, shared with S3); unset, the route uses us-east-1.
