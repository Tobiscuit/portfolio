// A stand-in for the Proprietor engine, for the smoke tests only
// (tests/smoke/harness.ts). Its name is the one the site's SEO binding asks
// for, and the harness runs it in the same `wrangler dev` process as the site,
// so the binding can only ever reach this stub, never the real engine.
// Modelled on montano-btm's tests/stubs/seo-engine (develop).
{
	"$schema": "../../../node_modules/wrangler/config-schema.json",
	"name": "seo-engine",
	"main": "index.ts",
	// On or after 2026-04-21, as the real engine's is: RPC errors keep their
	// name and own fields (enhanced error serialization).
	"compatibility_date": "2026-10-19",
	"d1_databases": [
		{
			"binding": "CALLS",
			"database_name": "seo_engine_stub",
			// Local only; never created in Cloudflare.
			"database_id": "5e0e0e0e-0000-4000-8000-0000000000a1"
		}
	]
}
